<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>disabled</ImplicitUsings>
    <Nullable>enable</Nullable>
    <WarningLevel>9999</WarningLevel>
    <TreatWarningsAsErrors>True</TreatWarningsAsErrors>
    <!-- All three projects ship together and share this number. Bump them together
         before tagging a release so the tag, the assemblies and the log header agree. -->
    <Version>1.1.0</Version>
    <!-- Source is grouped into folders (Configuration, Diagnostics, Abstractions,
         Scraping, Io, Resources) but everything stays in the single ShivendraGst.Core
         namespace, so front ends need only one using. -->
    <RootNamespace>ShivendraGst.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.0" />
    <PackageReference Include="ExcelDataReader" Version="3.7.0" />
    <PackageReference Include="Microsoft.Playwright" Version="1.54.0" />
  </ItemGroup>

  <!-- Copied into the output of whichever front end references this library, so both the
       console app and the WinForms app find it next to their own executable.
       Link flattens it out of Resources\ - ConfigReader looks for it beside the
       executable, not in a subfolder. -->
  <ItemGroup>
    <None Update="Resources\configFile.json">
      <Link>configFile.json</Link>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
