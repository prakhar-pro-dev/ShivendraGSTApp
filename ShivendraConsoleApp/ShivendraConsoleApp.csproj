<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>disabled</ImplicitUsings>
    <Nullable>enable</Nullable>
	  <WarningLevel>9999</WarningLevel>
	  <TreatWarningsAsErrors>True</TreatWarningsAsErrors>
	  <!-- Kept in step with ShivendraGst.Core and ShivendraGstWinApp. -->
	  <Version>1.1.0</Version>
  </PropertyGroup>

  <!-- The scraping engine, logger and config live in the shared Core library, which the
       WinForms front end also references. configFile.json travels with it and lands
       in this project's output folder. -->
  <ItemGroup>
    <ProjectReference Include="..\ShivendraGst.Core\ShivendraGst.Core.csproj" />
  </ItemGroup>

  <!-- Referenced directly so the Playwright package's targets deploy the browser driver
       next to this executable. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Playwright" Version="1.54.0" />
  </ItemGroup>

</Project>
