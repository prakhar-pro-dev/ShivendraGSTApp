<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>disabled</ImplicitUsings>
    <Nullable>enable</Nullable>
	  <WarningLevel>9999</WarningLevel>
	  <TreatWarningsAsErrors>True</TreatWarningsAsErrors>
	  <!-- Release version. Bump this before tagging a release so the tag, the assembly
	       and the log-file header all agree. Last released tag: v1.0.4. -->
	  <Version>1.0.5</Version>
  </PropertyGroup>

  <!-- The scraping engine, logger and config live in the shared Core library, which the
       WinForms front end also references. configFile.json and Convert_To_CSV.py travel
       with it and land in this project's output folder. -->
  <ItemGroup>
    <ProjectReference Include="..\ShivendraGst.Core\ShivendraGst.Core.csproj" />
  </ItemGroup>

  <!-- Referenced directly so the Playwright package's targets deploy the browser driver
       next to this executable. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Playwright" Version="1.54.0" />
  </ItemGroup>

</Project>
